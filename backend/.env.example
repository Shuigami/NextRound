# demo = données fictives (aucune clé requise) ; pandascore = données réelles
DATA_MODE=demo
PANDASCORE_TOKEN=
DATABASE_URL=postgresql+psycopg://nextround:nextround@localhost:5432/nextround
SYNC_INTERVAL_MINUTES=15
CORS_ORIGINS=http://localhost:3000
# Connexion Google (facultative) : identifiants OAuth de Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=http://localhost:3000
# E-mails (vérification, mot de passe oublié). Vide : les liens s'affichent dans la console du backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NextRound <no-reply@example.com>
